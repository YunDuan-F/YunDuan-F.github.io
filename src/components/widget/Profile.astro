---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import {
	getCategoryList,
	getSortedPostsList,
	getTagList,
} from "../../utils/content-utils";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const [posts, tags, categories] = await Promise.all([
	getSortedPostsList(),
	getTagList(),
	getCategoryList(),
]);
const stats = [
	{ label: "文章", value: posts.length },
	{ label: "标签", value: tags.length },
	{ label: "分类", value: categories.length },
];
---
<div class="profile-card card-base px-5 py-6">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mb-4 size-24 overflow-hidden rounded-2xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-3xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="h-full w-full"></ImageWrapper>
    </a>
    <div>
        <div class="font-bold text-2xl text-center mb-1 text-black/85 dark:text-white/90 transition">{config.name}</div>
        <div class="h-1 w-6 bg-[var(--primary)] mx-auto rounded-full mb-3 transition"></div>
        <div class="text-center text-sm leading-6 text-black/65 dark:text-white/60 mb-5 transition">{config.bio}</div>
        <div class="grid grid-cols-3 gap-2 mb-5">
            {stats.map((item) => (
                <div class="rounded-xl px-2 py-2 text-center transition hover:bg-[var(--primary)]/10">
                    <div class="mb-1 text-sm text-black/65 dark:text-white/60">{item.label}</div>
                    <div class="text-2xl font-semibold tabular-nums text-black/85 dark:text-white/90">{item.value}</div>
                </div>
            ))}
        </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                <Icon name={config.links[0].icon} class="text-[1.5rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>

<style>
    .profile-card {
        background:
            radial-gradient(circle at 50% -10%, color-mix(in oklch, var(--primary) 18%, transparent), transparent 42%),
            var(--card-bg);
    }
</style>

